# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=avtozyabr
POSTGRES_USER=avtozyabr
POSTGRES_PASSWORD=changeme

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated Telegram user IDs allowed to control the bot
TELEGRAM_ALLOWED_USERS=123456789

# ── Zolotoe Yabloko ───────────────────────────────────────────────────────────
ZY_BASE_URL=https://zolotoyabloko.ru
# Path to a Netscape-format cookies file exported from browser
# (optional; if absent, bot prompts for manual login)
ZY_COOKIES_FILE=/data/zy_cookies.txt

# ── Polling ───────────────────────────────────────────────────────────────────
# Seconds between wishlist polls for normal items
POLL_INTERVAL_NORMAL=300
# Seconds between polls for items marked "hot" (require_confirm=false)
POLL_INTERVAL_HOT=30

# ── Safety limits ─────────────────────────────────────────────────────────────
# Maximum total spend per day (RUB); 0 = no limit
DAILY_SPEND_LIMIT=0

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Debug ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
