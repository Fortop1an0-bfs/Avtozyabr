# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=avtozyabr
POSTGRES_USER=avtozyabr
POSTGRES_PASSWORD=changeme

# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Comma-separated Telegram user IDs allowed to control the bot
TELEGRAM_ALLOWED_USERS=123456789

# ── Goldapple ─────────────────────────────────────────────────────────────────
# Same retailer as zolotoyabloko.ru — both domains work, goldapple.ru is canonical.
ZY_BASE_URL=https://goldapple.ru
# Cookie store. Two formats accepted:
#   .json — flat {name: value, ..., x_auth_marker?: "..."} (written by /setcookies)
#   .txt  — Netscape cookies.txt exported from browser
# Use .json so /setcookies via Telegram persists across container restarts.
ZY_COOKIES_FILE=/data/zy_cookies.json
# FIAS UUID of the city used for wishlist (cityId) and cart (fiasId). Default: Moscow.
ZY_CITY_ID=0c5b2444-70a0-4932-980c-b4dc0d3f02b5

# ── Polling ───────────────────────────────────────────────────────────────────
# Seconds between wishlist polls for normal items
POLL_INTERVAL_NORMAL=300
# Seconds between polls for items marked "hot" (require_confirm=false)
POLL_INTERVAL_HOT=30

# ── Safety limits ─────────────────────────────────────────────────────────────
# Maximum total spend per day (RUB); 0 = no limit
DAILY_SPEND_LIMIT=0

# ── Sentry (optional) ─────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Debug ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
